DECLARATION_QA_MINERU_BACKEND=pipeline
DECLARATION_QA_MINERU_METHOD=auto
DECLARATION_QA_MINERU_LANGUAGE=ch
DECLARATION_QA_MINERU_MODEL_SOURCE=modelscope
DECLARATION_QA_MINERU_FORMULA_ENABLED=false
DECLARATION_QA_MINERU_TIMEOUT_SECONDS=3600
