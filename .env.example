DECLARATION_QA_ENV=development
DECLARATION_QA_ALLOW_IN_MEMORY_FALLBACKS=true

DECLARATION_QA_DATABASE_URL=postgresql+psycopg://agentbase:agentbase@localhost:5433/agentbase
DECLARATION_QA_REDIS_URL=redis://localhost:6380/1
DECLARATION_QA_REDIS_TTL_SECONDS=600
DECLARATION_QA_CONTEXT_MEMORY_ENABLED=true
DECLARATION_QA_SHORT_MEMORY_TTL_SECONDS=3600
DECLARATION_QA_LONG_MEMORY_TTL_SECONDS=604800
DECLARATION_QA_LONG_MEMORY_RETRIEVAL_CACHE_TTL_SECONDS=300
DECLARATION_QA_LONG_MEMORY_ASYNC_WORKERS=2
DECLARATION_QA_LONG_MEMORY_TOP_K=5
DECLARATION_QA_LONG_MEMORY_DISTANCE_THRESHOLD=0.4
DECLARATION_QA_LONG_MEMORY_KEYWORD_MIN_SCORE=0.2
DECLARATION_QA_MEMORY_MILVUS_COLLECTION=declaration_qa_context_memories
DECLARATION_QA_MEMORY_ELASTICSEARCH_INDEX=declaration_qa_context_memories

DECLARATION_QA_VECTOR_BACKEND=memory
DECLARATION_QA_MILVUS_URI=http://localhost:19530
DECLARATION_QA_MILVUS_TOKEN=
DECLARATION_QA_MILVUS_COLLECTION=declaration_qa_chunks
DECLARATION_QA_KEYWORD_BACKEND=memory
DECLARATION_QA_ELASTICSEARCH_URL=http://localhost:9200
DECLARATION_QA_ELASTICSEARCH_API_KEY=
DECLARATION_QA_ELASTICSEARCH_INDEX=declaration_qa_chunks

DECLARATION_QA_LLM_PROVIDER=dashscope
DECLARATION_QA_OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DECLARATION_QA_OPENAI_API_KEY=
DECLARATION_QA_LLM_MODEL=qwen-plus
DECLARATION_QA_AGENT_MODEL=qwen3-vl-plus
DECLARATION_QA_AGENT_FINAL_TIMEOUT_SECONDS=60
DECLARATION_QA_AGENT_MAX_ITERATIONS=4
DECLARATION_QA_AGENT_VL_MAX_EVIDENCE_IMAGES=3
DECLARATION_QA_AGENT_VL_MIN_IMAGE_SCORE=0.7
DECLARATION_QA_AGENT_VL_MAX_IMAGE_BYTES=10485760
DECLARATION_QA_MAX_RETRIEVAL_WORKERS=4

DECLARATION_QA_EMBEDDING_PROVIDER=qwen3-vl-embedding
DECLARATION_QA_EMBEDDING_MODEL=qwen3-vl-embedding
DECLARATION_QA_EMBEDDING_DIMENSIONS=1024
DECLARATION_QA_EMBEDDING_IMAGE_RES_LEVEL=0

DECLARATION_QA_RERANK_PROVIDER=dashscope
DECLARATION_QA_RERANK_API_KEY=
DECLARATION_QA_RERANK_MODEL=qwen3-vl-rerank
DECLARATION_QA_RERANK_SCORE_THRESHOLD=0.7
DECLARATION_QA_RERANK_MAX_SOURCES=20

DECLARATION_QA_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# 业务申请、进度状态和驳回数据读取自 DECLARATION_QA_DATABASE_URL 中的
# declaration_qa.business_* 表。

DECLARATION_QA_AUTH_REQUIRED=false
DECLARATION_QA_JWT_SECRET=replace-with-a-long-random-declaration-qa-secret
DECLARATION_QA_JWT_ALGORITHMS=HS256
DECLARATION_QA_INTERNAL_API_KEY=

DECLARATION_QA_OCR_API_URL=
DECLARATION_QA_OCR_API_KEY=
DECLARATION_QA_OCR_MODEL=qwen-vl-ocr-2025-11-20
DECLARATION_QA_QUERY_IMAGE_OCR_ENABLED=true
DECLARATION_QA_QUERY_IMAGE_OCR_MAX_CHARS=4000
DECLARATION_QA_QUERY_IMAGE_OCR_TIMEOUT_SECONDS=30
DECLARATION_QA_IMAGE_SUMMARY_ENABLED=true
# 留空时复用上面的 OCR API URL 和 API Key；也可单独配置视觉模型网关。
DECLARATION_QA_IMAGE_SUMMARY_API_URL=
DECLARATION_QA_IMAGE_SUMMARY_API_KEY=
DECLARATION_QA_IMAGE_SUMMARY_MODEL=qwen3-vl-plus
DECLARATION_QA_IMAGE_SUMMARY_MAX_TOKENS=1200
DECLARATION_QA_IMAGE_SUMMARY_TIMEOUT_SECONDS=60

DECLARATION_QA_DOCUMENT_PARSER_PROVIDER=auto
DECLARATION_QA_DOCUMENT_PARSER_ORDER=mineru,native
DECLARATION_QA_DOCUMENT_PARSER_FALLBACK_ENABLED=true
