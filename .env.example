DECLARATION_QA_ENV=production
DECLARATION_QA_ALLOW_IN_MEMORY_FALLBACKS=false

DECLARATION_QA_DATABASE_URL=postgresql+psycopg://agentbase:agentbase@localhost:5433/agentbase
DECLARATION_QA_REDIS_URL=redis://localhost:6380/1
DECLARATION_QA_REDIS_TTL_SECONDS=600

DECLARATION_QA_VECTOR_BACKEND=milvus
DECLARATION_QA_MILVUS_URI=http://localhost:19530
DECLARATION_QA_MILVUS_TOKEN=
DECLARATION_QA_MILVUS_COLLECTION=declaration_qa_chunks

DECLARATION_QA_LLM_PROVIDER=openai
DECLARATION_QA_OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DECLARATION_QA_OPENAI_API_KEY=
DECLARATION_QA_LLM_MODEL=qwen-plus
DECLARATION_QA_LLM_TEMPERATURE=0.1

DECLARATION_QA_EMBEDDING_PROVIDER=openai
DECLARATION_QA_EMBEDDING_MODEL=text-embedding-v4
DECLARATION_QA_EMBEDDING_DIMENSIONS=1536

DECLARATION_QA_RERANK_PROVIDER=http
DECLARATION_QA_RERANK_API_URL=
DECLARATION_QA_RERANK_API_KEY=
DECLARATION_QA_RERANK_MODEL=qwen3-rerank

DECLARATION_QA_BUSINESS_API_BASE_URL=
DECLARATION_QA_BUSINESS_API_TOKEN=
DECLARATION_QA_BUSINESS_API_TIMEOUT_SECONDS=5
DECLARATION_QA_BUSINESS_APPLICATION_PATH_TEMPLATE=/applications/{apply_id}
DECLARATION_QA_BUSINESS_STATUS_PATH_TEMPLATE=/applications/{apply_id}/status
DECLARATION_QA_BUSINESS_REJECT_PATH_TEMPLATE=/applications/{apply_id}/reject-info
DECLARATION_QA_BUSINESS_ACCESS_PATH_TEMPLATE=/applications/{apply_id}/access

DECLARATION_QA_AUTH_REQUIRED=true
DECLARATION_QA_JWT_SECRET=replace-with-a-long-random-declaration-qa-secret
DECLARATION_QA_JWT_ALGORITHMS=HS256
DECLARATION_QA_INTERNAL_API_KEY=

DECLARATION_QA_OCR_API_URL=
DECLARATION_QA_OCR_API_KEY=

DECLARATION_QA_INDEX_QUEUE_BACKEND=rq
DECLARATION_QA_INDEX_QUEUE_NAME=declaration-qa-index
DECLARATION_QA_INDEX_JOB_TIMEOUT_SECONDS=1800
DECLARATION_QA_UPLOAD_DIR=data/declaration_qa/uploads
DECLARATION_QA_SEED_KNOWLEDGE=false
