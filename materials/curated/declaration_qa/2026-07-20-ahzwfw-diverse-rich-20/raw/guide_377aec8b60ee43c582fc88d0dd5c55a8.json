    "fileSdyjJson": "[{\"fileBusiObjid\":\"4028e69c9e05630e019eb9f7091b6dac\",\"fileBusiType\":\"ENACTMENT_FILE\",\"fileExt\":\"doc\",\"fileMd5\":\"6087D1F347ED209F9A56AD03B363021F\",\"fileName\":\"注册会计师注册申请表.doc\",\"filePath\":\"group1/M00/16/5A/rBBQHV0TPsCAC-ECAACcAJ-qy40816.doc\",\"fileSize\":\"39936\",\"id\":\"4028e69c9e05630e019eb9f709806dae\"}]",
