    "cjwtJson": [
      {
        "problemTitle": "1、集中供养采取的主要方式是什么",
        "id": "24152B6BE366B44BE06302C7FE0A851E",
        "sort": "1",
        "problemAnswer": "接收1级至4级残疾军人进入荣誉军人康复医院等优抚医院进行休养、康复和医疗。"
      },
      {
        "problemTitle": "2、集中供养的1至4级残疾军人能否享受护理费待遇",
        "id": "24152B6BE364B44BE06302C7FE0A851E",
        "sort": "2",
        "problemAnswer": "1979年国务院、中央军委《关于做好部队退伍义务兵伤病残战士安置工作的通知》中规定：“住残废军人休养院的特等、一等残废军人、一律不发给护理费”，因此休养人员住院期间不发给护理费。但是，住院的1至4级残疾军人分散供养后，应发给护理费。"
      },
      {
        "problemTitle": "3、如何申请集中供养？",
        "id": "24152B6BE365B44BE06302C7FE0A851E",
        "sort": "3",
        "problemAnswer": "直接向户籍地退役军人事务部门提出申请即可。"
      }
    ],
